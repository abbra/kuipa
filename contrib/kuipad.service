[Unit]
Description=kuipa post-quantum enrollment daemon
Documentation=https://github.com/abbra/kuipa
# Socket activation (optional): with kuipad.socket enabled the daemon
# inherits the pre-bound /run/ipa/kuipad.sock; without it, 'serve' binds
# from the "listen" key of its config.  No Requires= so the service can be
# started on its own, as in ahdapa.service.
After=kuipad.socket dirsrv.target

[Service]
Type=simple
ExecStart=/usr/libexec/kuipad serve --config /etc/ipa/kuipad.json
Restart=on-failure
RestartSec=5s

# The daemon runs as root: it reads the keytabs in /var/kerberos/krb5
# and the IPA CA chain, and spawns the custody handlers as their own
# users (see "runas" in the config).
User=root

# Config, the CA chain and the PKINIT anchors under /etc/ipa are
# read-only; everything else is read-only too, except what the daemon
# writes at runtime: the keys, delegation.json and log heads under
# /var/lib/ipa/ku, and its own socket in /run/ipa.
ProtectSystem=strict
# The CA key handlers run pk12util on Dogtag's NSS database, which SQLite
# opens read-write even to export; the leading "-" keeps a server without
# a CA starting.
ReadWritePaths=/var/lib/ipa/ku /run/ipa -/etc/pki/pki-tomcat/alias

# Logs only to the journal: 'serve' writes its audit lines to stderr and
# kuipad keys its audit to its own log head, so a private /tmp and a
# private /dev are enough isolation.  LimitCORE=0 keeps a crashed daemon
# from dumping its keys into the journal.
PrivateTmp=yes
PrivateDevices=yes
# No NoNewPrivileges=: the daemon changes user to run the NSS key handlers
# as pkiuser (§18.5), and with it set that spawn fails with EPERM.
LimitCORE=0
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelLogs=yes
# SUID/SGID bits blocked on new files: they are how a process acquires
# another user's identity, and the custody handlers are not setuid
# helpers but plain executables kuipad runs as their configured user.
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictNamespaces=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
# A long-running unit, not on-demand: the anchor exchange, the voucher
# lease purge and the log-head publishing run inside 'serve'.  Enabled by
# ipa-server-install / ipa-replica-install.
WantedBy=multi-user.target
