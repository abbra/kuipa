[Unit]
Description=kuipa post-quantum enrollment daemon
Requires=kuipad.socket
After=kuipad.socket dirsrv.target

[Service]
ExecStart=/usr/libexec/kuipad serve --config /etc/ipa/kuipad.json
# Config, the CA chain and the trust anchors under /etc/ipa are read-only;
# the key directory is written at runtime: keys, delegation.json, log heads.
ReadOnlyPaths=/etc/ipa
ReadWritePaths=/var/lib/ipa/ku
PrivateTmp=true
NoNewPrivileges=true
LimitCORE=0
Restart=on-failure

[Install]
# A long-running unit, not on-demand: the anchor exchange and the lease purge
# run inside 'serve'.  Enabled by ipa-server-install / ipa-replica-install.
WantedBy=multi-user.target
