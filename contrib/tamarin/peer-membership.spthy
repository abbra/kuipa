// Membership state on its own: one linear MState token carrying the current
// or last generation, joined by join, rejoin and remove. The admission and
// validity rules of peer-admission-checks.spthy are omitted: they are not
// needed for these invariants, and as proof sources they make the searches
// exceed the memory limit. Realms, signatures, policies and validity intervals
// belong to that theory.
//
// A trace formula can only refer to action facts, so a fact that appears only in
// a rule's premises and conclusions is observable at NO index and a lemma whose
// antecedent is such a fact holds vacuously. This theory used to rely on two
// lemmas over MState(...) @ t; both were vacuous and are gone. The rules now
// emit MStateObs(realm,server,state) for the state each step consumes and the
// state it leaves, which is what makes the state visible; premises, conclusions
// and the reachable states are unchanged. Two further lemmas were dropped
// because they named a MembershipCurrent action that no rule here emits: reading
// current membership belongs to peer-admission-checks.spthy, where it does
// appear. The claim that an admitted claim has live membership is that theory's,
// not this one's. Earlier text here claimed a fact is "observable strictly
// between the steps that create and consume it"; that is wrong - there is no
// such window, and the probes that seemed to show it had parse errors.
//
// Verified: a MembershipStarted action observes the member state it creates (the
// induction subject the closure goals below need); the state at an admission step
// (a first join carries 'initial', a rejoin carries the retired generation it
// supersedes); a member state is never observed after that generation ended;
// generation uniqueness and provenance, a rejoin's required prior removal, that
// a rejoin changes the generation, and a join/remove/join trace; and that all
// three states really get observed (three witnesses), which is what makes the
// invariants above guarantees rather than empty statements.
// Three chain lemmas that would compose with the bridge above were tried and are
// not kept: an observation-sequence bridge (a member state followed by any later
// observation ends that generation), its rejoin-keyed form, and a two-starts-
// with-no-end-between helper that would identify the earlier generation. All
// three exhaust the search (exit 137 at 8 GiB, 400-450 s). They are scaffolding
// for the open goals below, not obligations in their own right.
// Open at 8 GiB, exit 137 (cgroup kill, not a timeout) at 400 and 700 seconds,
// and none is refuted. All three are NON-VACUOUS: their antecedents are
// reachable (Nonvac_state_closed_before_obs,
// Nonvac_inactive_membership_closes_prior_generations, and
// Nonvac_rejoin_closes_prior_generations, in this file and all verified), generated by
// contrib/ci/vacuity-probes.py, which exists-traces the antecedent alone with the
// conclusion's ordering removed. These are real obligations, not empty statements. the general closing
// property over observations (a generation started before an observed state has
// ended by then) - its earlier formulation appeared to verify only because the
// state fact it named was invisible; and the two forms that ask which earlier
// step ended a prior generation, which asks about a history rather than about
// the state at the acting step. The rejoin form verifies in 3 steps only while
// the first of those is assumed as an unproved [reuse] source, which is a result
// resting on an open goal, not a proof.
theory peer_membership
begin
// These are the structural restrictions from peer-admission-checks.spthy.
// Without the first one two state tokens could exist for one pair, which
// makes the generation-closing invariants below false.
restriction UniqueMembershipSlot:
  "All r1 r2 s #i #j. MembershipInitialized(r1,s) @i & MembershipInitialized(r2,s) @j ==> #i = #j"
restriction ServerHasOneRealm:
  "All r1 r2 s #i #j. Joined(r1,s) @i & Joined(r2,s) @j ==> r1 = r2"

rule initialize_membership:
  [ ] --[ MembershipInitialized($realm,$server), MStateObs($realm,$server,'initial') ]-> [ MState($realm,$server,'initial') ]

rule join:
  [ MState($realm,$server,'initial'), Fr(~generation) ]
  --[ Joined($realm,$server), MembershipStarted($realm,$server,~generation), MembershipInactive($realm,$server), MStateObs($realm,$server,'initial'), MStateObs($realm,$server,<'member',~generation>) ]-> [ MState($realm,$server,<'member',~generation>) ]

rule rejoin:
  [ MState($realm,$server,<'inactive',previous>), Fr(~generation) ]
  --[ Joined($realm,$server), Rejoined($realm,$server,previous,~generation), MembershipStarted($realm,$server,~generation), MembershipInactive($realm,$server), MStateObs($realm,$server,<'inactive',previous>), MStateObs($realm,$server,<'member',~generation>) ]-> [ MState($realm,$server,<'member',~generation>) ]

// Removal ends the generation; it must not also name that generation current
// on the step it ends it. Admission and readmission name the generation that
// is actually current.
rule remove:
  [ MState(realm,server,<'member',generation>) ]
  --[ Removed(realm,server), MembershipEnded(realm,server,generation), MStateObs(realm,server,<'member',generation>), MStateObs(realm,server,<'inactive',generation>) ]-> [ MState(realm,server,<'inactive',generation>) ]

// Membership state is observable only through the MStateObs actions the rules
// emit for the state they consume and the state they leave. A fact that appears
// only in premises and conclusions (MState) is observable at no index, so a goal
// over MState(...) @ t holds vacuously; the two lemmas here that named a
// MembershipCurrent action are also gone - no rule in this theory emits a read
// of current membership, so that claim has no subject here. Reads are modelled
// in peer-admission-checks.spthy.
lemma state_closed_before_obs [use_induction]:
  "All r s payload generation #i #j. MStateObs(r,s,payload) @i & MembershipStarted(r,s,generation) @j & #j < #i ==> (Ex current. payload = <'member',current> & generation = current) | (Ex #k. MembershipEnded(r,s,generation) @k & #j < #k & #k < #i)"

// Non-vacuity of state_closed_before_obs: its antecedent is satisfiable, so that lemma is a
// real obligation and not an empty statement. Generated from it by
// contrib/ci/vacuity-probes.py (exists-trace of the antecedent alone, the
// conclusion's ordering removed - with the ordering the search does not finish).
lemma Nonvac_state_closed_before_obs: exists-trace
  "Ex r s payload generation #i #j. MStateObs(r,s,payload) @i & MembershipStarted(r,s,generation) @j & #j < #i"
lemma member_state_not_ended_before [use_induction, reuse]:
  "All r s generation #i #j. MStateObs(r,s,<'member',generation>) @i & MembershipEnded(r,s,generation) @j ==> not (#j < #i)"
// The state carried at an admission step: 'initial' for a first join, a retired
// generation for a rejoin.
lemma inactive_carries_pre_state [use_induction]:
  "All r s #i. MembershipInactive(r,s) @i ==> (Ex p. MStateObs(r,s,p) @i)"
lemma rejoin_carries_retired [use_induction, reuse]:
  "All r s previous generation #i. Rejoined(r,s,previous,generation) @i ==> MStateObs(r,s,<'inactive',previous>) @i"
// Non-vacuity: all three states are observed.
lemma w_state_initial [use_induction]:
  exists-trace "Ex r s #t. MStateObs(r,s,'initial') @t"
lemma w_state_member [use_induction]:
  exists-trace "Ex r s g #t. MStateObs(r,s,<'member',g>) @t"
lemma w_state_retired [use_induction]:
  exists-trace "Ex r s g #t. MStateObs(r,s,<'inactive',g>) @t"
lemma membership_generation_unique [reuse]:
  "All r s r2 s2 generation #i #j. MembershipStarted(r,s,generation) @i & MembershipStarted(r2,s2,generation) @j ==> #i = #j"
lemma membership_generation_end_has_start [reuse]:
  "All r s generation #i. MembershipEnded(r,s,generation) @i ==> (Ex #j. MembershipStarted(r,s,generation) @j & #j < #i)"
lemma inactive_membership_closes_prior_generations [use_induction]:
  "All r s prior #i #j. MembershipInactive(r,s) @i & MembershipStarted(r,s,prior) @j & #j < #i ==> (Ex #k. MembershipEnded(r,s,prior) @k & #j < #k & #k < #i)"

// Non-vacuity of inactive_membership_closes_prior_generations: its antecedent is satisfiable, so that lemma is a
// real obligation and not an empty statement. Generated from it by
// contrib/ci/vacuity-probes.py (exists-trace of the antecedent alone, the
// conclusion's ordering removed - with the ordering the search does not finish).
lemma Nonvac_inactive_membership_closes_prior_generations: exists-trace
  "Ex r s prior #i #j. MembershipInactive(r,s) @i & MembershipStarted(r,s,prior) @j & #j < #i"
// The induction subject for the closure goals. Every rule that moves MState
// emits MStateObs for the state it consumes and the state it leaves, at its own
// index, so the observation sequence is the state chain: that is the only thing
// a trace formula can follow.
lemma started_observes_member [use_induction]:
  "All r s generation #j. MembershipStarted(r,s,generation) @j
    ==> MStateObs(r,s,<'member',generation>) @j"



// Not marked reuse: it is open, and everything after it would then rest on an
// unproved assumption (that is exactly how the earlier "verified in 3 steps"
// came about).
lemma rejoin_closes_prior_generations [use_induction]:
  "All r s prior previous generation #i #j. Rejoined(r,s,previous,generation) @i & MembershipStarted(r,s,prior) @j & #j < #i ==> (Ex #k. MembershipEnded(r,s,prior) @k & #j < #k & #k < #i)"

// Non-vacuity of rejoin_closes_prior_generations: its antecedent is satisfiable, so that lemma is a
// real obligation and not an empty statement. Generated from it by
// contrib/ci/vacuity-probes.py (exists-trace of the antecedent alone, the
// conclusion's ordering removed - with the ordering the search does not finish).
lemma Nonvac_rejoin_closes_prior_generations: exists-trace
  "Ex r s prior previous generation #i #j. Rejoined(r,s,previous,generation) @i & MembershipStarted(r,s,prior) @j & #j < #i"
lemma rejoin_has_prior_removal [reuse]:
  "All r s previous generation #i. Rejoined(r,s,previous,generation) @i ==> (Ex #j. Removed(r,s) @j & MembershipEnded(r,s,previous) @j & #j < #i)"
lemma rejoin_changes_generation [reuse]:
  "All r s previous generation #i. Rejoined(r,s,previous,generation) @i ==> not (previous = generation)"

lemma rejoin_witness: exists-trace
  "Ex r s #i #j #k. Joined(r,s) @i & Removed(r,s) @j & Joined(r,s) @k & #i < #j & #j < #k"
end
