// Admission checks with symbolic validity intervals and membership removal.
// Validity is an oracle: StartValidity introduces an attacker-chosen entry
// as valid and EndValidity ends that interval. Algorithms are symbolic key
// tags with one statically approved tag per realm; JWK parsing and concrete
// algorithm semantics are not modeled. Concurrent batches, replacement,
// retention and trust are omitted. Server identities belong to one realm and
// membership can be removed and re-added.
// Honest anchors sign attacker-chosen claims and successors. Rejection
// properties (denied tags, own vouches), signature and validity-interval
// provenance, the admission-follows-a-join claim, and the admission, rejoin and
// post-rejoin witnesses verify. Three
// goals are open at 40 GiB: that an admitted claim's membership is live, that an
// admitted claim after a removal follows a rejoin, and that admission names a
// server belonging to one realm. None is refuted and no counterexample is known; the negations
// were not searched. All three are NON-VACUOUS: their antecedents are reachable
// (Nonvac_admitted_claim_has_membership,
// Nonvac_removed_member_requires_rejoin and Nonvac_admitted_server_has_one_realm,
// in this file and all verified), generated by
// contrib/ci/vacuity-probes.py. One of the four goals open in earlier rounds closed without
// touching its statement: claim_admission_has_prior_join was given
// [use_induction], which makes the induction run on the admission token instead
// of the whole trace, and it verifies. Two of the three remaining goals already
// carry that attribute; it was tried on the third (admitted_server_has_one_realm)
// and made no difference at 8 GiB and 700 s, so the attribute is not a general
// fix - it helps when the lemma's subject is a token the rules move. A static
// audit for this gap is cheap: compare each lemma's attributes with those of its
// verified siblings in the same theory.
// The
// membership-generation lifecycle lemmas are in peer-membership.spthy: with
// these admission rules present as proof sources those searches exceed the
// memory limit, while the state machine alone verifies in seconds.
theory peer_admission_checks
begin
builtins: signing

restriction Equality:
  "All x y #i. Eq(x,y) @i ==> x = y"
restriction Inequality:
  "All x #i. Neq(x,x) @i ==> F"
restriction UniqueMembershipSlot:
  "All r1 r2 s #i #j. MembershipInitialized(r1,s) @i & MembershipInitialized(r2,s) @j ==> #i = #j"
restriction ServerHasOneRealm:
  "All r1 r2 s #i #j. Joined(r1,s) @i & Joined(r2,s) @j ==> r1 = r2"

rule configure:
  [ Fr(~ownsk) ]
  --[ Configured($realm,<'approved',pk(~ownsk)>) ]->
  [ !Config($realm,<'approved',pk(~ownsk)>), !OwnSecret($realm,~ownsk),
    !Allowed($realm,'approved'), Out(<'approved',pk(~ownsk)>) ]

rule compromise_own:
  [ !OwnSecret(realm,sk) ]
  --[ OwnCompromised(realm,<'approved',pk(sk)>) ]-> [ Out(sk) ]

rule observe_own_vouch:
  [ !Config(realm,own), In(<claim,sig>) ]
  --[ Eq(verify(sig,<'vouch',realm,own,claim>,snd(own)),true),
      OwnVouchOffered(realm,own,claim) ]-> [ ]

rule create_anchor:
  [ Fr(~sk) ]
  --[ AnchorCreated($realm,<'approved',pk(~sk)>) ]->
  [ !AnchorSecret($realm,~sk), Out(<'approved',pk(~sk)>) ]

// This deliberately permits an honest anchor to vouch for any input claim.
rule issue_vouch:
  [ !AnchorSecret(realm,sk), In(claim) ]
  --[ VouchIssued(realm,<'approved',pk(sk)>,claim) ]->
  [ Out(sign(<'vouch',realm,<'approved',pk(sk)>,claim>,sk)) ]

// Rotation authorization is abstracted: any requested successor may be signed.
rule issue_succession:
  [ !AnchorSecret(realm,sk), In(next) ]
  --[ SuccessionIssued(realm,<'approved',pk(sk)>,next) ]->
  [ Out(sign(<'succession',realm,<'approved',pk(sk)>,next>,sk)) ]

rule compromise_anchor:
  [ !AnchorSecret(realm,sk) ]
  --[ AnchorCompromised(realm,<'approved',pk(sk)>) ]-> [ Out(sk) ]

rule initialize_membership:
  [ ] --[ MembershipInitialized($realm,$server) ]-> [ MState($realm,$server,'initial') ]

rule join:
  [ MState($realm,$server,'initial'), Fr(~generation) ]
  --[ Joined($realm,$server), MembershipStarted($realm,$server,~generation), MembershipInactive($realm,$server) ]-> [ MState($realm,$server,<'member',~generation>) ]

rule rejoin:
  [ MState($realm,$server,<'inactive',previous>), Fr(~generation) ]
  --[ Joined($realm,$server), Rejoined($realm,$server,previous,~generation), MembershipStarted($realm,$server,~generation), MembershipInactive($realm,$server) ]-> [ MState($realm,$server,<'member',~generation>) ]

// Removal ends the generation; it must not also name that generation current
// on the step it ends it. Admission and readmission name the generation that
// is actually current.
rule remove:
  [ MState(realm,server,<'member',generation>) ]
  --[ Removed(realm,server), MembershipEnded(realm,server,generation) ]-> [ MState(realm,server,<'inactive',generation>) ]

// Each validity identifier names one oracle interval, not an entry lifetime.
// A new interval can start for the same entry, including after an earlier end.
rule start_validity:
  [ Fr(~id), In(entry) ]
  --[ ValidityStarted(~id,entry) ]->
  [ Valid(~id,entry), Out(~id) ]

rule end_validity:
  [ Valid(id,entry) ]
  --[ ValidityEnded(id,entry), ValidityCurrent(id,entry) ]-> [ ]

rule accept_key:
  [ !Config(realm,own), !Allowed(realm,alg), In(<alg,key>) ]
  --[ KeyAdmitted(realm,<alg,key>) ]->
  [ !Key(realm,<alg,key>) ]

rule accept_claim:
  [ !Config(realm,own), MState(realm,server,<'member',generation>),
    Valid(id,<'claim',realm,server,key>), In(<id,server,key>) ]
  --[ ClaimAdmitted(realm,server,key,id), MembershipCurrent(realm,server,generation),
      ValidityCurrent(id,<'claim',realm,server,key>) ]->
  [ MState(realm,server,<'member',generation>), Valid(id,<'claim',realm,server,key>) ]

rule accept_vouch:
  [ !Config(realm,own), !Key(realm,anchor),
    Valid(id,<'vouch',realm,anchor,claim>), In(<id,claim,sig>) ]
  --[ Neq(anchor,own), Eq(verify(sig,<'vouch',realm,anchor,claim>,snd(anchor)),true),
      VouchAdmitted(realm,own,anchor,claim,id), ValidityCurrent(id,<'vouch',realm,anchor,claim>) ]->
  [ Valid(id,<'vouch',realm,anchor,claim>) ]

rule accept_succession:
  [ !Config(realm,own), !Allowed(realm,alg), Valid(id,<'succession',realm,<alg,old>,new>),
    In(<id,alg,old,new,sig>) ]
  --[ Eq(verify(sig,<'succession',realm,<alg,old>,new>,old),true),
      SuccessionAdmitted(realm,<alg,old>,new,id), ValidityCurrent(id,<'succession',realm,<alg,old>,new>) ]->
  [ Valid(id,<'succession',realm,<alg,old>,new>) ]

lemma forged_own_vouch_offered: exists-trace
  "Ex r own claim #i #j. OwnCompromised(r,own) @i & OwnVouchOffered(r,own,claim) @j & #i < #j"
lemma rejected_denied_key:
  "All r key #i. KeyAdmitted(r,<'denied',key>) @i ==> F"
lemma rejected_denied_vouch:
  "All r own key claim id #i. VouchAdmitted(r,own,<'denied',key>,claim,id) @i ==> F"
lemma rejected_denied_succession:
  "All r key next id #i. SuccessionAdmitted(r,<'denied',key>,next,id) @i ==> F"
// [use_induction] is load-bearing here: without it this lemma exhausted the
// search at every setting tried (exit 137 at 8 GiB, 400-700 s); with it the
// induction runs on the admission token instead of the whole trace, and it
// verifies. See the header for the other three, where the same attribute is
// present or was added and does not help.
lemma claim_admission_has_prior_join [use_induction]:
  "All r s key id #i. ClaimAdmitted(r,s,key,id) @i ==> (Ex #j. Joined(r,s) @j & #j < #i)"
lemma admitted_server_has_one_realm:
  "All r1 r2 s key1 key2 id1 id2 #i #j. ClaimAdmitted(r1,s,key1,id1) @i & ClaimAdmitted(r2,s,key2,id2) @j ==> r1 = r2"

// Non-vacuity of admitted_server_has_one_realm: its antecedent is satisfiable, so that lemma is a
// real obligation and not an empty statement. Generated from it by
// contrib/ci/vacuity-probes.py (exists-trace of the antecedent alone, the
// conclusion's ordering removed - with the ordering the search does not finish).
lemma Nonvac_admitted_server_has_one_realm: exists-trace
  "Ex r1 r2 s key1 key2 id1 id2 #i #j. ClaimAdmitted(r1,s,key1,id1) @i & ClaimAdmitted(r2,s,key2,id2) @j"
lemma admitted_distinct_realms_witness: exists-trace
  "Ex r1 r2 s1 s2 key1 key2 id1 id2 #i #j. ClaimAdmitted(r1,s1,key1,id1) @i & ClaimAdmitted(r2,s2,key2,id2) @j & not (r1 = r2)"
lemma rejoined_claim_witness: exists-trace
  "Ex r s previous generation k id #i #j. Rejoined(r,s,previous,generation) @i & ClaimAdmitted(r,s,k,id) @j & MembershipCurrent(r,s,generation) @j & #i < #j"
lemma claim_readmitted_after_validity_ends [heuristic=C]: exists-trace
  "Ex r s k first second #i #j #t #u. ClaimAdmitted(r,s,k,first) @i & ValidityEnded(first,<'claim',r,s,k>) @j & ValidityStarted(second,<'claim',r,s,k>) @t & ClaimAdmitted(r,s,k,second) @u & not (first = second) & #i < #j & #j < #t & #t < #u"
lemma claim_admission_witness: exists-trace
  "Ex r s k id #i. ClaimAdmitted(r,s,k,id) @i"
lemma honest_vouch_readmitted_after_validity_ends [heuristic=C]: exists-trace
  "Ex r own anchor claim first second #h #i #j #t #u. VouchIssued(r,anchor,claim) @h & VouchAdmitted(r,own,anchor,claim,first) @i & ValidityEnded(first,<'vouch',r,anchor,claim>) @j & ValidityStarted(second,<'vouch',r,anchor,claim>) @t & VouchAdmitted(r,own,anchor,claim,second) @u & not (first = second) & #h < #i & #i < #j & #j < #t & #t < #u & not (Ex r2 a2 #k. AnchorCompromised(r2,a2) @k)"
lemma honest_succession_readmitted_after_validity_ends [heuristic=C]: exists-trace
  "Ex r old new first second #h #i #j #t #u. SuccessionIssued(r,old,new) @h & SuccessionAdmitted(r,old,new,first) @i & ValidityEnded(first,<'succession',r,old,new>) @j & ValidityStarted(second,<'succession',r,old,new>) @t & SuccessionAdmitted(r,old,new,second) @u & not (first = second) & #h < #i & #i < #j & #j < #t & #t < #u & not (Ex r2 a2 #k. AnchorCompromised(r2,a2) @k)"
lemma stolen_anchor_forges_succession: exists-trace
  "Ex r old new id #i #j. AnchorCompromised(r,old) @i & SuccessionAdmitted(r,old,new,id) @j & #i < #j & not (Ex #k. SuccessionIssued(r,old,new) @k)"
lemma stolen_anchor_forges_vouch: exists-trace
  "Ex r own anchor claim id #i #j. AnchorCompromised(r,anchor) @i & VouchAdmitted(r,own,anchor,claim,id) @j & #i < #j & not (Ex #k. VouchIssued(r,anchor,claim) @k)"
lemma admitted_claim_has_membership [use_induction]:
  "All r s k id #i. ClaimAdmitted(r,s,k,id) @i ==> (Ex #j. Joined(r,s) @j & #j < #i & not (Ex #t. Removed(r,s) @t & #j < #t & #t < #i))"

// Non-vacuity of admitted_claim_has_membership: its antecedent is satisfiable, so that lemma is a
// real obligation and not an empty statement. Generated from it by
// contrib/ci/vacuity-probes.py (exists-trace of the antecedent alone, the
// conclusion's ordering removed - with the ordering the search does not finish).
lemma Nonvac_admitted_claim_has_membership: exists-trace
  "Ex r s k id #i. ClaimAdmitted(r,s,k,id) @i"
lemma removed_member_requires_rejoin [use_induction]:
  "All r s k id #i #j. Removed(r,s) @i & ClaimAdmitted(r,s,k,id) @j & #i < #j ==> (Ex #t. Joined(r,s) @t & #i < #t & #t < #j)"

// Non-vacuity of removed_member_requires_rejoin: its antecedent is satisfiable, so that lemma is a
// real obligation and not an empty statement. Generated from it by
// contrib/ci/vacuity-probes.py (exists-trace of the antecedent alone, the
// conclusion's ordering removed - with the ordering the search does not finish).
lemma Nonvac_removed_member_requires_rejoin: exists-trace
  "Ex r s k id #i #j. Removed(r,s) @i & ClaimAdmitted(r,s,k,id) @j & #i < #j"
lemma admitted_vouch_has_known_key:
  "All r own a c id #i. VouchAdmitted(r,own,a,c,id) @i ==> (Ex #j. KeyAdmitted(r,a) @j & #j < #i)"
lemma own_vouch_not_admitted:
  "All r own c id #i. VouchAdmitted(r,own,own,c,id) @i ==> F"
lemma admitted_honest_anchor_vouch_origin:
  "All r own anchor claim id #i #j. AnchorCreated(r,anchor) @i & VouchAdmitted(r,own,anchor,claim,id) @j ==> (Ex #k. VouchIssued(r,anchor,claim) @k & #k < #j) | (Ex #k. AnchorCompromised(r,anchor) @k & #k < #j)"
lemma admitted_honest_anchor_succession_origin:
  "All r old new id #i #j. AnchorCreated(r,old) @i & SuccessionAdmitted(r,old,new,id) @j ==> (Ex #k. SuccessionIssued(r,old,new) @k & #k < #j) | (Ex #k. AnchorCompromised(r,old) @k & #k < #j)"
lemma expired_claim_not_admitted [use_induction]:
  "All r s k id #i #j. ValidityEnded(id,<'claim',r,s,k>) @i & ClaimAdmitted(r,s,k,id) @j ==> not (#i < #j)"
lemma expired_vouch_not_admitted [use_induction]:
  "All r own anchor claim id #i #j. ValidityEnded(id,<'vouch',r,anchor,claim>) @i & VouchAdmitted(r,own,anchor,claim,id) @j ==> not (#i < #j)"
lemma expired_succession_not_admitted [use_induction]:
  "All r old new id #i #j. ValidityEnded(id,<'succession',r,old,new>) @i & SuccessionAdmitted(r,old,new,id) @j ==> not (#i < #j)"
// [reuse] is valid here: this one verifies on its own (1300 s, nothing assumed),
// unlike the open lemma above it, whose [reuse] was removed because three later
// lemmas were reading it as an assumption.
lemma validity_interval_origin [use_induction, reuse]:
  "All id entry #i. ValidityCurrent(id,entry) @i ==> (Ex #j. ValidityStarted(id,entry) @j & #j < #i)"
lemma admitted_claim_has_started_validity:
  "All r s key id #i. ClaimAdmitted(r,s,key,id) @i ==> (Ex #j. ValidityStarted(id,<'claim',r,s,key>) @j & #j < #i)"
lemma admitted_vouch_has_started_validity:
  "All r own anchor claim id #i. VouchAdmitted(r,own,anchor,claim,id) @i ==> (Ex #j. ValidityStarted(id,<'vouch',r,anchor,claim>) @j & #j < #i)"
lemma admitted_succession_has_started_validity:
  "All r old new id #i. SuccessionAdmitted(r,old,new,id) @i ==> (Ex #j. ValidityStarted(id,<'succession',r,old,new>) @j & #j < #i)"
end
