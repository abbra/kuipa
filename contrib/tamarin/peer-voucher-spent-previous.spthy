// The previous code, as controls for peer-voucher-spent.spthy, which has the
// same join and the current rules. Three behaviours:
//  - the record was on the host entry, so deleting the host freed the salt
//    (`host_delete_old`, `SpentOnHostEntry`);
//  - the salt was released after any failure of a join, whether or not the host
//    was gone (`release_after_failure_old`, `ReleasedWithHost`);
//  - there was no home server: each server's directory held its own copy of the
//    salt and a server spent its own, so two servers that took the same voucher
//    before their directories replicated both accepted it (`issue_replicated`,
//    `TwoCopies`). A salt `Slot` appears twice, once per directory.
//
// Run 2026-11-13, Tamarin 1.12.0, Maude 3.5.1, proofs.sh -t 300 (8 GiB), one lemma
// per process.
theory peer_voucher_spent_previous
begin

rule issue:
  [ Fr(~salt) ]
  --[ Issued(~salt) ]->
  [ Slot(~salt, 'fresh'), Alive(~salt) ]

// A redeemer, the server that takes a join, asks the voucher's home server to
// spend the salt and adds the host entry when the home server answers ok
// (kuipad's join in directory.rs). Only the home server writes the record:
// `Slot` is its one token for the salt, the directory entry, and it names the
// redeemer the record was written for. The two steps are one here: a join that
// the home server answered ok for and then refused, with no host made, has the
// record released and is a step that changes nothing. `Pending` is the join
// between the host add and the group update.
rule join_add:
  [ Slot(salt, 'fresh'), Fr(~host) ]
  --[ HomeSpent(salt, $r), HostCreated(salt, ~host, $r) ]->
  [ Slot(salt, 'spent'), Host(~host, salt), Pending(~host, salt, $r) ]

// The group update succeeds and the join is done.
rule group_ok:
  [ Pending(host, salt, r) ]
  --[ Joined(salt, host) ]->
  [ ]

// The group update fails and the host delete succeeds: the voucher enrolled
// no one and the redeemer has the record released, so a retry can work.
rule group_fails_rollback:
  [ Pending(host, salt, r), Host(host, salt), Slot(salt, 'spent') ]
  --[ RolledBack(salt, host, r) ]->
  [ Slot(salt, 'fresh') ]

// The group update fails and the host delete fails too, or the host add
// committed but reported an error: a host may exist. The redeemer does not
// ask for a release and the record stays.
rule group_fails_host_remains:
  [ Pending(host, salt, r) ]
  --[ HostRemains(salt, host) ]->
  [ ]

// The previous code, rule 1: the record was on the host entry, so deleting the
// host freed the salt.
rule host_delete_old:
  [ Host(host, salt), Slot(salt, 'spent') ]
  --[ HostDeleted(host, salt), SpentOnHostEntry(salt) ]->
  [ Slot(salt, 'fresh') ]

// Rule 2: the salt was released after any failure of a join, whether or not the
// host was gone.
rule release_after_failure_old:
  [ Pending(host, salt, r), Slot(salt, 'spent') ]
  --[ ReleasedWithHost(salt) ]->
  [ Slot(salt, 'fresh') ]

// Rule 3: no home server. Each directory had its own copy of the salt, fresh
// until the record replicated, and each server spent its own: the issuer's
// voucher reaches both servers before either record has.
rule issue_replicated:
  [ Fr(~salt) ]
  --[ Issued(~salt), TwoCopies(~salt) ]->
  [ Slot(~salt, 'fresh'), Slot(~salt, 'fresh'), Alive(~salt) ]

// Current code: the host goes, the record stays.
rule host_delete:
  [ Host(host, salt) ]
  --[ HostDeleted(host, salt) ]->
  [ ]

// The window closes. An unused voucher lapses with it; a spent one leaves its
// record waiting to be purged.
rule expire:
  [ Alive(salt) ]
  --[ Expired(salt) ]->
  [ Closed(salt) ]

rule lapse:
  [ Closed(salt), Slot(salt, 'fresh') ]
  --[ Lapsed(salt) ]->
  [ ]

rule purge:
  [ Closed(salt), Slot(salt, 'spent') ]
  --[ Purged(salt) ]->
  [ ]

// Reachability: under each previous behaviour a salt makes two hosts that both
// exist.
lemma old_code_reuses_salt: exists-trace
  "Ex salt h1 h2 #i #j. Joined(salt, h1) @i & Joined(salt, h2) @j & #i < #j & not(h1 = h2)"
lemma two_directories_two_hosts: exists-trace
  "Ex salt h1 h2 r1 r2 #i #j #k. HostCreated(salt, h1, r1) @i & HostCreated(salt, h2, r2) @j & TwoCopies(salt) @k & not(h1 = h2) & not(#i = #j)"

// The claims of peer-voucher-spent.spthy fail with the previous rules. Expected
// to be falsified.
lemma salt_single_use_previous:
  "All salt h1 h2 #i #j. Joined(salt, h1) @i & Joined(salt, h2) @j ==> #i = #j"
lemma second_host_needs_rollback_previous:
  "All salt h1 h2 r1 r2 #i #j. HostCreated(salt, h1, r1) @i & HostCreated(salt, h2, r2) @j & #i < #j
     ==> Ex #k. RolledBack(salt, h1, r1) @k & #i < #k & #k < #j"
end
